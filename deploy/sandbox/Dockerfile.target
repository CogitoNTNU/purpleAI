FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir flask==3.1.0 gunicorn==23.0.0
COPY src/defender/vulnerable-app/ ./
COPY deploy/sandbox/check_network.py ./check_network.py
ENV PYTHONDONTWRITEBYTECODE=1 VULNSHOP_DB_PATH=/data/vulnshop.db
USER 10001:10001
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "app:app"]
