# Reserve these PC addresses in the router; replace the examples.
RED_IP=192.168.0.130
BLUE_IP=192.168.0.120
# Resolve on the host: getent ahostsv4 llm.hpc.ntnu.no
# Use one current IPv4 address, and update firewall and stack if it changes.
IDUN_IP=129.241.121.16
IDUN_MODEL=openai/gpt-oss-120b
# Generate a different token on each PC: openssl rand -hex 32
GATEWAY_TOKEN=
GATEWAY_CALL_LIMIT=1000
