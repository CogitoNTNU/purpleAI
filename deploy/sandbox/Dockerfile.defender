FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir flask==3.1.0 requests==2.34.2 gunicorn==23.0.0 'langchain-openai>=1.0,<2'
COPY src/defender/defender-agent/defender.py .
COPY deploy/sandbox/check_network.py ./check_network.py
ENV PYTHONDONTWRITEBYTECODE=1 LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false
USER 10001:10001
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "180", "defender:app"]
