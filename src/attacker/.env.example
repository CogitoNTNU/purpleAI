# Copy this file to `.env` (in this same folder) and fill in the values.
#   cp .env.example .env
# `.env` is gitignored, so your keys are never committed.
# Both the Boss (redagent.py) and the langgraph dev server read this file.

# --- LLM (required) ---
LLM_API_KEY=your-llm-key-here

# --- LangSmith tracing (full Boss + subagent reasoning in the web UI) ---
# Turn tracing on:
LANGSMITH_TRACING=true
# Your LangSmith API key (looks like lsv2_...). This is the only credential
# LangSmith needs — there is no separate "username" for tracing.
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
# A label that groups all runs from this framework together in the UI.
# Set it to whatever you like (e.g. your username or the engagement name).
LANGSMITH_PROJECT=purpleai-attacker
# Only uncomment if your LangSmith account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
