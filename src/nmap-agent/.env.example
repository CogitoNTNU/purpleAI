# Choose any model available on Idun.
AGENT_MODEL=openai/gpt-oss-120b

# The two-PC sandbox supplies the target and gateway credentials automatically.
# Only set the following when running the agent directly outside the sandbox:
# TARGET_URL=http://192.168.0.120:8080
# IDUN_BASE_URL=https://llm.hpc.ntnu.no/v1
# IDUN_API_KEY=your-idun-api-key
# NMAP_PORT=8080
# Optional log label only; sandbox/gamehost runs set this automatically.
# PURPLEAI_TARGET_MODE=with_defender

# Optional gamehost delivery outside the sandbox. Set both values together.
# LOG_COLLECTOR_URL=http://192.168.0.110:8765/events
# LOG_COLLECTOR_TOKEN=replace-with-the-gamehost-token
