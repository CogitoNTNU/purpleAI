# PurpleAI Gamehost Log Collector Configuration

# Authentication token - must match LOG_COLLECTOR_TOKEN in agent .env files
# Generate a secure random token: openssl rand -base64 32
GAMEHOST_LOG_TOKEN=your-secure-token-here

# IP address to bind to
# 0.0.0.0 = accept from any machine on network (required for blue team PC)
# 127.0.0.1 = only accept from localhost
GAMEHOST_LOG_BIND=0.0.0.0

# Port to listen on
GAMEHOST_LOG_PORT=8765

# Optional: Change where events are stored (default: data/events.jsonl)
# GAMEHOST_LOG_FILE=/path/to/custom/events.jsonl
