# Collector LAN address and shared log token (openssl rand -hex 32).
GAMEHOST_LOG_BIND=192.168.0.110
GAMEHOST_LOG_TOKEN=

# SSH destinations from gamehost. Use existing aliases or user@PC-address.
RED_SSH=redai
BLUE_SSH=blueai
# Repository path on both PCs, relative to the SSH user's home or absolute.
REMOTE_REPO=purpleAI

# Normal traffic runs only with the defender, on port 8080.
BLUE_IP=192.168.0.120
